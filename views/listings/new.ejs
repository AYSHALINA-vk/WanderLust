<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WanderLust</title>
</head>
<body>
    <form method = "POST" action = "/listings">
        <label for="title">Title:</label>
        <input type="text" name="title" id="title" required placeholder="Enter title"><br><br>

        <label for="description">Description:</label>
        <textarea name="description" id="description" required placeholder="Enter description"></textarea><br><br>

        <label for="price">Price:</label>
        <input type="number" name="price" id="price" required placeholder="Enter price"><br><br>

        <label for="location">Location:</label>
        <input type="text" name="location" id="location" required placeholder="Enter location"><br><br>

        <label for="image">Image URL:</label>
        <input type="text" name="image" id="image" required placeholder="Enter image URL"><br><br>

        <label for="country">Country:</label>
        <input type="text" name="country" id="country" required placeholder="Enter country"><br><br>

        <button type="submit">Create Listing</button>

    </form>
    
</body>
</html>